{
  "name": "juggernaut-bedrock",
  "version": "0.0.0",
  "description": "Route Claude Code, Codex, OpenCode, and Grok through Amazon Bedrock with IAM, SSO, or API keys. Safe cross-platform CLI.",
  "bin": {
    "juggernaut": "./index.js"
  },
  "scripts": {
    "preinstall": "node preinstall.js",
    "test": "node --test"
  },
  "optionalDependencies": {
    "juggernaut-bedrock-linux-x64": "0.0.0",
    "juggernaut-bedrock-linux-arm64": "0.0.0",
    "juggernaut-bedrock-darwin-x64": "0.0.0",
    "juggernaut-bedrock-darwin-arm64": "0.0.0",
    "juggernaut-bedrock-win32-x64": "0.0.0"
  },
  "os": ["darwin", "linux", "win32"],
  "cpu": ["x64", "arm64"],
  "keywords": [
    "bedrock",
    "amazon-bedrock",
    "aws",
    "claude",
    "claude-code",
    "anthropic",
    "codex",
    "opencode",
    "grok",
    "genai",
    "ai-coding",
    "llm",
    "coding-agent",
    "cli",
    "iam",
    "sso",
    "mantle",
    "claude-code-bedrock",
    "amazon-bedrock-cli",
    "aws-claude",
    "bedrock-coding-agent",
    "claude-code-aws",
    "developer-tools"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jpvelasco/juggernaut.git"
  },
  "bugs": {
    "url": "https://github.com/jpvelasco/juggernaut/issues"
  },
  "homepage": "https://github.com/jpvelasco/juggernaut#readme"
}
