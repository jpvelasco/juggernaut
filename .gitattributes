# Auto-detect text files and normalize line endings
* text=auto

# Shell scripts must use LF (Unix) line endings — bash chokes on CRLF
*.sh text eol=lf
*.fish text eol=lf

# Entry point script without .sh extension
setup text eol=lf
juggernaut text eol=lf

# Shellcheck config
.shellcheckrc text eol=lf
.gitattributes text eol=lf

# PowerShell scripts use CRLF (Windows)
*.ps1 text eol=crlf

# JSON/YAML config files — LF for consistency
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Markdown — LF for consistency
*.md text eol=lf

# Keep VERSION file with LF
VERSION text eol=lf

# Intentionally-CRLF test fixture for profile detection/removal tests.
# Do not normalize on checkout; bash profile_writer must handle CRLF.
tests/v2/fixtures/profile_crlf.sh -text eol=crlf
