#!/usr/bin/env bash
# bin/claude — Juggernaut launcher.
# Inject AWS_BEARER_TOKEN_BEDROCK from the OS keychain into the environment,
# then exec the real `claude` binary. Silent on success, non-fatal on keychain
# failure (claude still launches — the user can authenticate another way).

set -uo pipefail

resolve_script_dir() {
  local source="$1"
  local source_dir target
  while [[ -L "$source" ]]; do
    source_dir="$(cd -P "$(dirname "$source")" && pwd)"
    target="$(readlink "$source")"
    [[ "$target" != /* ]] && target="$source_dir/$target"
    source="$target"
  done
  cd -P "$(dirname "$source")" && pwd
}

SCRIPT_DIR="$(resolve_script_dir "${BASH_SOURCE[0]}")"
INSTALL_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

if [[ -z "${AWS_BEARER_TOKEN_BEDROCK:-}" ]]; then
  if [[ -r "$INSTALL_DIR/lib/keychain.sh" ]]; then
    # shellcheck source=../lib/keychain.sh
    . "$INSTALL_DIR/lib/keychain.sh"
    if token="$(keychain_get 2>/dev/null)" && [[ -n "$token" ]]; then
      export AWS_BEARER_TOKEN_BEDROCK="$token"
    fi
  fi
fi

# Identify this script's real path so we can skip ourselves during PATH scan.
self_dir_real="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
self_real="$self_dir_real/$(basename "${BASH_SOURCE[0]}")"

target="${JUGGERNAUT_CLAUDE_BIN:-}"
if [[ -z "$target" ]]; then
  IFS=':' read -r -a _jug_path <<< "$PATH"
  for d in "${_jug_path[@]}"; do
    [[ -z "$d" ]] && continue
    for name in claude claude.exe claude.cmd; do
      cand="$d/$name"
      if [[ -x "$cand" || ( "$name" != "claude" && -f "$cand" ) ]]; then
        cand_dir_real="$(cd -P "$(dirname "$cand")" 2>/dev/null && pwd)" || continue
        cand_real="$cand_dir_real/$(basename "$cand")"
        if [[ "$cand_real" == "$self_real" ]]; then
          continue
        fi
        # Resolve symlinks: if the candidate points back to us, skip too.
        if [[ -L "$cand" ]]; then
          link_target="$(readlink "$cand")"
          [[ "$link_target" != /* ]] && link_target="$cand_dir_real/$link_target"
          link_real_dir="$(cd -P "$(dirname "$link_target")" 2>/dev/null && pwd)" || link_real_dir=""
          if [[ -n "$link_real_dir" ]]; then
            link_real="$link_real_dir/$(basename "$link_target")"
            [[ "$link_real" == "$self_real" ]] && continue
          fi
        fi
        target="$cand"
        break 2
      fi
    done
  done
fi

if [[ -z "$target" ]]; then
  echo "claude: no upstream binary found on PATH (Juggernaut launcher at $self_real)" >&2
  exit 127
fi

exec "$target" "$@"
